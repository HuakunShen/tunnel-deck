{
  "name": "ssh-tunnel-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "serve": "node apps/server/dist/server.mjs",
    "tui": "node apps/tui/dist/tui.mjs",
    "tui:solid": "node apps/tui-solid/dist/main.js",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml}\"",
    "test:ci": "vitest run --exclude 'apps/tui/**'"
  },
  "devDependencies": {
    "@microsoft/tui-test": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "prettier": "^3.7.4",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
