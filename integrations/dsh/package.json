{
  "name": "dsh-plugin-ssh-tunnel",
  "version": "0.1.0",
  "type": "module",
  "description": "SSH tunnel manager as a DeepSeek Harness panel: the tunnel workbench mounted on the harness web server, rendered in the harness Web shell.",
  "license": "MIT",
  "icon": "./icon.svg",
  "meta": {
    "title": "TunnelDeck",
    "description": "One-click SSH tunnels: remember every forward, start/stop from a panel."
  },
  "exports": {
    ".": "./src/host.ts",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "bun ./scripts/build.ts"
  },
  "dependencies": {
    "@ssh-tunnel/host-node": "workspace:*",
    "@ssh-tunnel/service": "workspace:*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@ssh-tunnel/build-helper": "workspace:*"
  }
}
