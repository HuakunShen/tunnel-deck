{
  "name": "vscode-ssh-tunnel",
  "displayName": "TunnelDeck",
  "description": "One-click SSH tunnels: remember every forward, start/stop from the sidebar.",
  "version": "0.1.0",
  "private": true,
  "publisher": "sshtunnel",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sshTunnel",
          "title": "TunnelDeck",
          "icon": "assets/tunnel.svg"
        }
      ]
    },
    "views": {
      "sshTunnel": [
        {
          "id": "sshTunnel.tunnels",
          "name": "Tunnels"
        }
      ]
    },
    "commands": [
      {
        "command": "ssh-tunnel.start",
        "title": "Start Tunnel",
        "category": "TunnelDeck",
        "icon": "$(play)"
      },
      {
        "command": "ssh-tunnel.stop",
        "title": "Stop Tunnel",
        "category": "TunnelDeck",
        "icon": "$(stop)"
      },
      {
        "command": "ssh-tunnel.probe",
        "title": "Probe Tunnel",
        "category": "TunnelDeck",
        "icon": "$(pulse)"
      },
      {
        "command": "ssh-tunnel.stopAll",
        "title": "Stop All Tunnels",
        "category": "TunnelDeck"
      },
      {
        "command": "ssh-tunnel.refresh",
        "title": "Refresh",
        "category": "TunnelDeck",
        "icon": "$(refresh)"
      },
      {
        "command": "ssh-tunnel.openWorkbench",
        "title": "Open Workbench",
        "category": "TunnelDeck"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ssh-tunnel.refresh",
          "when": "view == sshTunnel.tunnels",
          "group": "navigation"
        },
        {
          "command": "ssh-tunnel.openWorkbench",
          "when": "view == sshTunnel.tunnels",
          "group": "navigation"
        },
        {
          "command": "ssh-tunnel.stopAll",
          "when": "view == sshTunnel.tunnels"
        }
      ],
      "view/item/context": [
        {
          "command": "ssh-tunnel.start",
          "when": "view == sshTunnel.tunnels && viewItem == tunnelStopped",
          "group": "inline"
        },
        {
          "command": "ssh-tunnel.stop",
          "when": "view == sshTunnel.tunnels && viewItem == tunnelRunning",
          "group": "inline"
        },
        {
          "command": "ssh-tunnel.probe",
          "when": "view == sshTunnel.tunnels",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "TunnelDeck",
      "properties": {
        "sshTunnel.daemonUrl": {
          "type": "string",
          "default": "",
          "description": "Daemon URL to attach to (empty = spawn/attach http://127.0.0.1:7432)."
        }
      }
    }
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "bun ./scripts/build.ts",
    "package": "pnpm build && npx -y @vscode/vsce package --no-dependencies -o ssh-tunnel-0.1.0.vsix"
  },
  "dependencies": {
    "@ssh-tunnel/client": "workspace:*",
    "@ssh-tunnel/contract": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/vscode": "1.90.0",
    "@ssh-tunnel/build-helper": "workspace:*"
  }
}
