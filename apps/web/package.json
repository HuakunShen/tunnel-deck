{
  "name": "@ssh-tunnel/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SSH tunnel console: SvelteKit static SPA served by the daemon, embedded in Tauri/VS Code/DSH.",
  "scripts": {
    "dev": "vite dev",
    "build": "bun ./scripts/build.ts",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error"
  },
  "dependencies": {
    "@lucide/svelte": "catalog:",
    "@ssh-tunnel/client": "workspace:*",
    "@ssh-tunnel/contract": "workspace:*",
    "@ssh-tunnel/core": "workspace:*",
    "@ssh-tunnel/web-ui": "workspace:*",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0"
  },
  "devDependencies": {
    "@ssh-tunnel/build-helper": "workspace:*",
    "@sveltejs/adapter-static": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
