{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TunnelDeck",
  "version": "0.1.3",
  "identifier": "dev.tunneldeck.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "TunnelDeck",
        "width": 1080,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "One-click SSH tunnel manager.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/HuakunShen/tunnel-deck/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCMDJBMUE2REU3OUE5N0EKUldSNnFYbmVwcUVDMjVaVW9VMnBSZlJVWG9DNFdBMUdkUWNJNHdiRmtORlRwN2R1Zm13TGlPOEYK"
    }
  }
}
